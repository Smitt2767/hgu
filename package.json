{
  "name": "hgu",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --network-family-autoselection-attempt-timeout=3000\" next build",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" next dev",
    "db:studio": "cross-env NODE_OPTIONS=\"--network-family-autoselection-attempt-timeout=3000\" drizzle-kit studio",
    "generate:db-schema": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload generate:types",
    "lint": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" next lint",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" next start",
    "migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=\"--no-deprecation --network-family-autoselection-attempt-timeout=3000\" payload migrate:status",
    "ci": "pnpm migrate && pnpm build"
  },
  "dependencies": {
    "@clocklimited/payload-2fa": "3.0.0-beta.1",
    "@gsap/react": "2.1.2",
    "@payloadcms/admin-bar": "3.71.1",
    "@payloadcms/db-postgres": "3.71.1",
    "@payloadcms/live-preview-react": "3.71.1",
    "@payloadcms/next": "3.71.1",
    "@payloadcms/plugin-mcp": "3.71.1",
    "@payloadcms/plugin-seo": "3.71.1",
    "@payloadcms/richtext-lexical": "3.71.1",
    "@payloadcms/storage-vercel-blob": "3.71.1",
    "@payloadcms/translations": "3.71.1",
    "@payloadcms/ui": "3.71.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "16.8.1",
    "gsap": "3.14.2",
    "lucide-react": "0.562.0",
    "next": "16.1.4",
    "next-intl": "4.7.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "3.71.1",
    "postcss": "8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tinycolor2": "1.6.0",
    "typescript": "5.7.3",
    "vaul": "^1.1.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@types/tinycolor2": "1.4.6",
    "@vitejs/plugin-react": "4.5.2",
    "drizzle-kit": "0.31.7",
    "eslint": "9.16.0",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "prettier": "3.4.2",
    "tw-animate-css": "1.4.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "18.20.2 || >=20.9.0",
    "pnpm": "9 || 10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": "1.26.0"
    }
  }
}
