DATABASE_URL=postgres://hgu:hgu@localhost:5432/hgu
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PREVIEW_SECRET=
PAYLOAD_MCP_API_KEY=

# Set by Vercel automatically once a Blob store is linked to the project.
# Leave empty locally: with no token the storage adapter disables itself and
# uploads are written to ./media on disk.
BLOB_READ_WRITE_TOKEN=

# GrowthBook. Local and production point at the same SDK Connection, so this is
# the same key in both places. Leave empty and the app still builds and renders —
# getRuleset() returns null and every flag falls back to its declared default.
GROWTHBOOK_CLIENT_KEY=
# Cloud. Override only for a self-hosted GrowthBook.
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
# Shared secret of the GrowthBook SDK Webhook that expires the cached ruleset.
# Found in SDK Configuration → SDK Connections, next to the webhook you point at
# POST /api/growthbook/webhook. Unset means the endpoint answers 500 and flags
# simply refresh on their own within the five-minute stale window.
GROWTHBOOK_WEBHOOK_SECRET=
# Signs precomputed URL segments. Only needed once a flag uses the precompute
# tier; also gates /api/flags/debug in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FLAGS_SECRET=

# Only read by Claude Code to resolve the MCP server URL in .mcp.json.
# Unset means localhost; point it at a deployment to drive that instance instead:
#   export PAYLOAD_MCP_URL=https://<your-app>.vercel.app/api/mcp
PAYLOAD_MCP_URL=
